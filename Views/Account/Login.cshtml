@model HelpDesk.Web.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Iniciar sesión</h1>
                <p class="text-muted mb-4">Ingresá con tu usuario o correo institucional.</p>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Identificador, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Identificador, new
                        {
                            @class = "form-control",
                            autocomplete = "username",
                            autofocus = "autofocus"
                        })
                        @Html.ValidationMessageFor(m => m.Identificador, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            autocomplete = "current-password"
                        })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-check mb-4">
                        @Html.CheckBoxFor(m => m.Recordarme, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.Recordarme, new { @class = "form-check-label" })
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                }

                <div class="alert alert-info mt-4 mb-0 small">
                    <strong>Usuarios de prueba</strong><br />
                    admin / admin<br />
                    usuario / usuario
                </div>
            </div>
        </div>
    </div>
</div>

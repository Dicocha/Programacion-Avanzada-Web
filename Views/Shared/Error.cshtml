@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
}

<div class="text-center py-5">
    <h1 class="display-6">Ha ocurrido un error</h1>
    <p class="lead">No fue posible completar la operación solicitada. Intente nuevamente.</p>
    <a class="btn btn-primary" href="@Url.Action("Index", "Tickets")">Volver al inicio</a>
</div>

@model HelpDesk.Web.Models.ViewModels.TicketsIndexViewModel
@{
    ViewBag.Title = "Tickets";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Tickets</h1>
        <p class="text-muted mb-0">
            @(User.IsInRole("Administrador")
                ? "Todos los tickets registrados en el sistema."
                : "Tus solicitudes de soporte.")
        </p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create", "Tickets")">Nuevo ticket</a>
</div>

<form id="ticketsFiltro" class="row g-2 align-items-end mb-4" method="get" action="@Url.Action("Index", "Tickets")" role="search">
    <div class="col-sm-6 col-lg-5">
        <label class="form-label" for="buscar">Buscar</label>
        <input class="form-control" id="buscar" name="buscar" value="@Model.Buscar" placeholder="Título o número" autocomplete="off" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <label class="form-label" for="estado">Estado</label>
        @Html.DropDownList("estado", Model.Estados, "Todos", new { @class = "form-select" })
    </div>
    <div class="col-sm-auto">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
    <div class="col-sm-auto">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Tickets")">Limpiar</a>
    </div>
</form>

<div id="ticketsTableContainer">
    @Html.Partial("_TicketTable", Model.Tickets)
</div>

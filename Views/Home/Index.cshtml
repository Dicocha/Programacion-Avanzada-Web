@{
    ViewBag.Title = "Inicio";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">Sistema de Gestión de Solicitudes de Soporte</h1>
        <p class="col-md-10 fs-5">
            Plataforma interna para registrar incidencias técnicas, dar seguimiento a los tickets
            y gestionar la carga de trabajo del área de soporte.
        </p>
        <p class="mb-0">
            Sesión iniciada como <strong>@ViewBag.Usuario</strong>
            <span class="badge bg-primary">@ViewBag.Rol</span>
        </p>
    </div>
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="alert alert-info">
        Como administrador podés gestionar tickets, asignar responsables y consultar reportes.
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Solicitudes</h2>
                <p class="card-text">Los colaboradores podrán registrar y consultar sus tickets de soporte.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Seguimiento</h2>
                <p class="card-text">Comentarios y cambios de estado se actualizarán sin recargar la página.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title">Reportes</h2>
                <p class="card-text">El área administrativa podrá analizar la carga y los tiempos de atención.</p>
            </div>
        </div>
    </div>
</div>
